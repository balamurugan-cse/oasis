import random
import string


secure_random = random.SystemRandom()


def prompt_positive_int(message: str) -> int:
    while True:
        raw_value = input(message).strip()
        try:
            value = int(raw_value)
        except ValueError:
            print("Please enter a valid whole number.")
            continue

        if value <= 0:
            print("Please enter a number greater than zero.")
            continue

        return value


def prompt_yes_no(message: str) -> bool:
    while True:
        answer = input(message).strip().lower()
        if answer in {"y", "yes"}:
            return True
        if answer in {"n", "no"}:
            return False
        print("Please respond with y or n.")


def build_character_pool(include_lowercase: bool, include_uppercase: bool, include_digits: bool, include_symbols: bool) -> list[str]:
    pool: list[str] = []
    if include_lowercase:
        pool.extend(string.ascii_lowercase)
    if include_uppercase:
        pool.extend(string.ascii_uppercase)
    if include_digits:
        pool.extend(string.digits)
    if include_symbols:
        pool.extend(string.punctuation)
    return pool


def generate_password(length: int, include_lowercase: bool, include_uppercase: bool, include_digits: bool, include_symbols: bool) -> str:
    selected_groups = []
    if include_lowercase:
        selected_groups.append(string.ascii_lowercase)
    if include_uppercase:
        selected_groups.append(string.ascii_uppercase)
    if include_digits:
        selected_groups.append(string.digits)
    if include_symbols:
        selected_groups.append(string.punctuation)

    if not selected_groups:
        raise ValueError("At least one character type must be selected.")

    if length < len(selected_groups):
        raise ValueError("Password length must be at least the number of selected character types.")

    password_chars = [secure_random.choice(group) for group in selected_groups]
    pool = build_character_pool(include_lowercase, include_uppercase, include_digits, include_symbols)
    password_chars.extend(secure_random.choice(pool) for _ in range(length - len(password_chars)))
    secure_random.shuffle(password_chars)
    return "".join(password_chars)


def main() -> None:
    print("Secure Password Generator")
    print("-------------------------")

    length = prompt_positive_int("Desired password length: ")
    include_lowercase = prompt_yes_no("Include lowercase letters? (y/n): ")
    include_uppercase = prompt_yes_no("Include uppercase letters? (y/n): ")
    include_digits = prompt_yes_no("Include digits? (y/n): ")
    include_symbols = prompt_yes_no("Include special symbols? (y/n): ")

    try:
        password = generate_password(
            length,
            include_lowercase,
            include_uppercase,
            include_digits,
            include_symbols,
        )
    except ValueError as error:
        print(f"Error: {error}")
        return

    print(f"\nGenerated password: {password}")


if __name__ == "__main__":
    main()
